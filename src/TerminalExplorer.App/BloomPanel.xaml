<UserControl x:Class="TerminalExplorer.BloomPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок + лёгкая легенда цветов -->
        <TextBlock Grid.Row="0" x:Name="HeaderText" Margin="10,8,10,4"
                   Foreground="{DynamicResource Accent}"
                   FontFamily="{DynamicResource MonoFont}"
                   TextWrapping="Wrap"/>

        <!-- Визуальная блок-схема: строится в коде из примитивов -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="10,0,10,10">
            <StackPanel x:Name="VisualHost" Margin="0" HorizontalAlignment="Left"/>
        </ScrollViewer>
    </Grid>
</UserControl>