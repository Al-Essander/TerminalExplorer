<UserControl x:Class="TerminalExplorer.BloomPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="HeaderText" Margin="10,8"
                   Foreground="{DynamicResource Accent}"
                   FontFamily="{DynamicResource MonoFont}"
                   TextWrapping="Wrap"/>
        <Viewbox Grid.Row="1" Margin="10,0,10,10" Stretch="Uniform"
                 StretchDirection="DownOnly">
            <TextBlock x:Name="AsciiText" FontFamily="{DynamicResource MonoFont}"
                       Foreground="{DynamicResource Foreground}"
                       TextWrapping="NoWrap"/>
        </Viewbox>
    </Grid>
</UserControl>