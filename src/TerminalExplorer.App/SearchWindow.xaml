<Window x:Class="TerminalExplorer.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:TerminalExplorer"
        Title="{DynamicResource L_SearchTitle}"
        Height="600" Width="940"
        MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Background}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="None">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ЗАГОЛОВОК -->
            <Grid Grid.Row="0" Background="{DynamicResource Selection}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource L_SearchTitle}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Accent}"/>
                <Button HorizontalAlignment="Right" Width="34" Content="X"
                        BorderThickness="0" Click="Close_Click"/>
            </Grid>

            <!-- ШАПКА: поле запроса + переключатели области и режима поиска -->
            <Grid Grid.Row="1" Margin="14,12,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="QueryBox"
                         FontFamily="{DynamicResource MonoFont}"
                         TextChanged="QueryBox_TextChanged"
                         KeyDown="QueryBox_KeyDown"/>
                <ComboBox Grid.Column="1" x:Name="ModeBox" Margin="8,0,0,0"
                          Width="170" SelectionChanged="ModeBox_Changed">
                    <ComboBoxItem Content="{DynamicResource L_ModeName}"/>
                    <ComboBoxItem Content="{DynamicResource L_ModeContent}"/>
                </ComboBox>
                <ComboBox Grid.Column="2" x:Name="ScopeBox" Margin="8,0,0,0"
                          Width="170" SelectionChanged="ScopeBox_Changed">
                    <ComboBoxItem Content="{DynamicResource L_ScopeFolder}"/>
                    <ComboBoxItem Content="{DynamicResource L_ScopeDrives}"/>
                </ComboBox>
            </Grid>

            <!-- ОСНОВНАЯ ОБЛАСТЬ: слева результаты, справа панель обработки -->
            <Grid Grid.Row="2" Margin="14,10,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- РЕЗУЛЬТАТЫ -->
                <Border Grid.Column="0" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        Background="{DynamicResource Surface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="StatusText" Margin="8,4"
                                   Foreground="{DynamicResource Dim}"/>
                        <ListView Grid.Row="1" x:Name="ResultList"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,1,6,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       Foreground="{DynamicResource Accent}"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FullPath}"
                                                       Margin="8,0,0,0"
                                                       Foreground="{DynamicResource Dim}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Snippet}"
                                                   Margin="20,2,0,0"
                                                   Foreground="{DynamicResource Accent}"
                                                   FontFamily="{DynamicResource MonoFont}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              Background="{DynamicResource Background}"/>

                <!-- ПАНЕЛЬ ОБРАБОТКИ ЗАПРОСА -->
                <Border Grid.Column="2" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        Background="{DynamicResource Surface}">
                    <local:BloomPanel x:Name="Bloom"/>
                </Border>
            </Grid>

            <!-- СТАТУСНАЯ СТРОКА -->
            <Grid Grid.Row="3" Background="{DynamicResource Selection}" Height="30" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="FooterText" Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Accent}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Content="{DynamicResource L_Close}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>