<Window x:Class="TerminalExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:TerminalExplorer"
        Title="{DynamicResource L_AppTitle}"
        Icon="app.ico"
        Height="700" Width="1100"
        MinHeight="400" MinWidth="700"
        Background="{DynamicResource Background}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        Deactivated="Window_Deactivated"
        WindowStyle="None"
        AllowsTransparency="False">

    <!--
        Безрамочное окно (п. 5.1 паспорта). WindowChrome оставляет системе изменение
        размера и привязку к краям, но убирает отрисовку заголовка: CaptionHeight=0
        означает, что вся шапка — наша.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="5"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:IconConverter x:Key="Icon"/>
        <local:PathIconConverter x:Key="PathIcon"/>

        <!-- Цвет строки задаётся типом объекта: папки акцентом, скрытые приглушённо. -->
        <Style x:Key="NameCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!--
            Вкладка. Активная выделена фоном и подчёркнута акцентом снизу — так же,
            как в проводнике Windows 11, только без скруглений.
        -->
        <Style x:Key="TabBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Margin" Value="0,0,1,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxWidth" Value="{DynamicResource TabMaxWidth}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Крестик закрытия: невидим, пока курсор не над вкладкой. -->
        <Style x:Key="TabClose" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
        </Style>

        <ContextMenu x:Key="FileMenu">
            <MenuItem Header="{DynamicResource L_MenuOpen}" Click="MenuOpen_Click"/>
            <MenuItem Header="{DynamicResource L_MenuOpenInTab}" Click="MenuOpenInTab_Click"/>
            <MenuItem Header="{DynamicResource L_MenuEdit}" InputGestureText="F4" Click="MenuEdit_Click"/>
            <Separator/>
            <MenuItem Header="{DynamicResource L_MenuCopy}" InputGestureText="Ctrl+C" Click="MenuCopy_Click"/>
            <MenuItem Header="{DynamicResource L_MenuCut}" InputGestureText="Ctrl+X" Click="MenuCut_Click"/>
            <MenuItem Header="{DynamicResource L_MenuPaste}" InputGestureText="Ctrl+V" Click="MenuPaste_Click"/>
            <MenuItem Header="{DynamicResource L_MenuDelete}" InputGestureText="Del" Click="MenuDelete_Click"/>
            <Separator/>
            <MenuItem Header="{DynamicResource L_MenuCopyPath}" Click="MenuCopyPath_Click"/>
            <MenuItem Header="{DynamicResource L_MenuReveal}" Click="MenuReveal_Click"/>
            <MenuItem Header="{DynamicResource L_MenuRename}" InputGestureText="F2" Click="MenuRename_Click"/>
            <MenuItem Header="{DynamicResource L_MenuTerminal}" Click="MenuTerminal_Click"/>
            <Separator/>
            <MenuItem Header="{DynamicResource L_MenuFavorite}" Click="MenuAddFavorite_Click"/>
            <Separator/>
            <MenuItem Header="{DynamicResource L_MenuProperties}" Click="MenuProperties_Click"/>
            <Separator/>
            <MenuItem Header="{DynamicResource L_MenuShell}" InputGestureText="Shift+ПКМ" Click="MenuShell_Click"/>
        </ContextMenu>

        <!-- Меню элемента избранного. Tag кнопки несёт сам FavoriteItem. -->
        <ContextMenu x:Key="FavoriteMenu">
            <MenuItem Header="{DynamicResource L_MenuOpen}" Click="FavoriteMenuOpen_Click"/>
            <MenuItem Header="{DynamicResource L_MenuOpenInTab}" Click="FavoriteMenuOpenInTab_Click"/>
            <Separator/>
            <MenuItem Header="{DynamicResource L_FavUp}" Click="FavoriteMenuUp_Click"/>
            <MenuItem Header="{DynamicResource L_FavDown}" Click="FavoriteMenuDown_Click"/>
            <Separator/>
            <MenuItem Header="{DynamicResource L_MenuCopyPath}" Click="FavoriteMenuCopyPath_Click"/>
            <MenuItem Header="{DynamicResource L_FavRemove}" Click="FavoriteMenuRemove_Click"/>
        </ContextMenu>

        <ContextMenu x:Key="DriveMenu">
            <MenuItem Header="{DynamicResource L_MenuOpen}" Click="DriveMenuOpen_Click"/>
            <MenuItem Header="{DynamicResource L_MenuOpenInTab}" Click="DriveMenuOpenInTab_Click"/>
            <Separator/>
            <MenuItem Header="{DynamicResource L_DriveFavorite}" Click="DriveMenuFavorite_Click"/>
            <MenuItem Header="{DynamicResource L_MenuTerminal}" Click="DriveMenuTerminal_Click"/>
            <Separator/>
            <MenuItem Header="{DynamicResource L_MenuProperties}" Click="DriveMenuProperties_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ЗАГОЛОВОК -->
            <Grid Grid.Row="0" Background="{DynamicResource Selection}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource Accent}"
                               Text="{DynamicResource L_AppTitle}"/>
                    <TextBlock Foreground="{DynamicResource Accent}"
                               Margin="8,0,0,0"
                               Text="{DynamicResource L_AppVersion}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleButton}" Content="≡" Width="30" ToolTip="{DynamicResource L_SettingsTooltip}" Click="Settings_Click"/>
                    <Button Style="{StaticResource TitleButton}" Content="_" Click="Minimize_Click"/>
                    <Button Style="{StaticResource TitleButton}" Content="[ ]" Click="Maximize_Click"/>
                    <Button Style="{StaticResource TitleButton}" Content="X" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- ВКЛАДКИ -->
            <Grid Grid.Row="1" Background="{DynamicResource Background}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TabBar">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Средний клик закрывает вкладку — обрабатывается на всей области. -->
                                <Border Style="{StaticResource TabBorder}"
                                        MouseDown="Tab_MouseDown"
                                        Height="{DynamicResource TabHeight}"
                                        Tag="{Binding}">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="{DynamicResource TabPadding}">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource TabTitle}"/>
                                        <Button Style="{StaticResource TabClose}" Content="x"
                                                Tag="{Binding}" Click="TabClose_Click"
                                                ToolTip="{DynamicResource L_CloseTab}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Column="1" Content="+" Width="28" Padding="0" Margin="2,2,4,2"
                        BorderThickness="0" ToolTip="{DynamicResource L_NewTabTooltip}"
                        Click="NewTab_Click"/>
            </Grid>

            <!-- ПАНЕЛЬ НАВИГАЦИИ -->
            <Grid Grid.Row="2" Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BackButton" Content="&lt;" Width="30"
                        ToolTip="{DynamicResource L_Back}" Click="Back_Click"/>
                <Button Grid.Column="1" x:Name="ForwardButton" Content="&gt;" Width="30" Margin="2,0,0,0"
                        ToolTip="{DynamicResource L_Forward}" Click="Forward_Click"/>
                <Button Grid.Column="2" x:Name="UpButton" Content="^" Width="30" Margin="2,0,0,0"
                        ToolTip="{DynamicResource L_Up}" Click="Up_Click"/>
                <Button Grid.Column="3" x:Name="SearchButton" Content="?" Width="30" Margin="2,0,0,0"
                        ToolTip="{DynamicResource L_Search}" Click="Search_Click"/>
                <!-- Приглашение показывает текущий диск, иначе оно вводило бы в заблуждение. -->
                <TextBlock Grid.Column="4" x:Name="PromptText" Text=" C:\&gt; " VerticalAlignment="Center"
                           Foreground="{DynamicResource Dim}"/>

                <TextBox Grid.Column="5" x:Name="PathBox"
                         KeyDown="PathBox_KeyDown"/>
            </Grid>

            <!-- ОСНОВНАЯ ОБЛАСТЬ -->
            <Grid Grid.Row="3" Margin="4,0,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" x:Name="SidebarColumn"/>
                    <ColumnDefinition Width="4" x:Name="SidebarSplitColumn"/>
                    <ColumnDefinition Width="*" MinWidth="200" x:Name="ListColumn"/>
                    <ColumnDefinition Width="4" x:Name="TerminalSplitColumn"/>
                    <ColumnDefinition Width="1.2*" MinWidth="240" x:Name="TerminalColumn"/>
                    <ColumnDefinition Width="4" x:Name="DetailsSplitColumn"/>
                    <ColumnDefinition Width="0" x:Name="DetailsColumn"/>
                </Grid.ColumnDefinitions>

                <!-- БОКОВАЯ ПАНЕЛЬ -->
                <Border Grid.Column="0" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{DynamicResource L_Drives}" Margin="0,2,0,4"
                                   Foreground="{DynamicResource Accent}"/>

                        <ItemsControl Grid.Row="1" x:Name="DriveList" Background="Transparent" BorderThickness="0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Left"
                                            BorderThickness="0"
                                            Padding="6,3"
                                            Tag="{Binding Path}"
                                            ContextMenu="{StaticResource DriveMenu}"
                                            Click="Drive_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="16" Height="16" Margin="0,0,7,0"
                                                   VerticalAlignment="Center"
                                                   Source="{Binding Path, Converter={StaticResource PathIcon}}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Header}"/>
                                                <TextBlock Text="{Binding Bar}" Foreground="{DynamicResource Dim}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ИЗБРАННОЕ: плюсик добавляет текущую папку, как в Blender. -->
                        <Grid Grid.Row="2" Margin="0,10,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource L_Favorites}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Accent}"/>
                            <Button Grid.Column="1" x:Name="AddFavoriteButton" Content="+" Width="22" Padding="0"
                                    Margin="0,0,3,0" BorderThickness="0"
                                    ToolTip="{DynamicResource L_AddToFavorites}"
                                    Click="AddFavorite_Click"/>
                        </Grid>

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="FavoriteList" Background="Transparent" BorderThickness="0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" HorizontalContentAlignment="Left"
                                                    BorderThickness="0" Padding="6,3"
                                                    Tag="{Binding}"
                                                    ToolTip="{Binding Path}"
                                                    ContextMenu="{StaticResource FavoriteMenu}"
                                                    Click="Favorite_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Width="16" Height="16" Margin="0,0,7,0"
                                                           VerticalAlignment="Center"
                                                           Source="{Binding Path, Converter={StaticResource PathIcon}}"/>
                                                    <TextBlock Text="{Binding Display}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Content="-" Width="20" Padding="0"
                                                    BorderThickness="0"
                                                    Foreground="{DynamicResource Dim}"
                                                    Tag="{Binding}"
                                                    ToolTip="{DynamicResource L_FavRemove}"
                                                    Click="RemoveFavorite_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- АДДОНЫ: закреплённые, то есть с "pinned": true в манифесте. -->
                        <Grid Grid.Row="4" Margin="0,10,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource L_Addons}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Accent}"/>
                            <Button Grid.Column="1" Content="..." Width="26" Padding="0"
                                    Margin="0,0,3,0" BorderThickness="0"
                                    ToolTip="{DynamicResource L_AddonsFolder}"
                                    Click="AddonsMenu_Click"/>
                        </Grid>

                        <ItemsControl Grid.Row="5" x:Name="AddonList" Background="Transparent"
                                      BorderThickness="0" Margin="0,0,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Left"
                                            BorderThickness="0" Padding="6,3"
                                            Tag="{Binding}"
                                            ToolTip="{Binding Description}"
                                            Click="Addon_Click">
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              Background="{DynamicResource Background}"/>

                <!--
                    Виртуализация включена явно. Ключевой пункт — CanContentScroll=True:
                    при плавной прокрутке (False) WPF материализует все строки сразу,
                    и на папке в 100 000 файлов окно просто зависает.
                -->
                <ListView Grid.Column="2" x:Name="FileList"
                          ItemContainerStyle="{StaticResource DosRow}"
                          ContextMenu="{StaticResource FileMenu}"
                          PreviewMouseRightButtonDown="FileList_RightDown"
                          PreviewMouseRightButtonUp="FileList_ShellMenu"
                          MouseDoubleClick="FileList_MouseDoubleClick"
                          KeyDown="FileList_KeyDown"
                          PreviewTextInput="FileList_PreviewTextInput"
                          AllowDrop="True"
                          PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                          MouseMove="FileList_MouseMove"
                          PreviewMouseWheel="FileList_PreviewMouseWheel"
                          DragOver="FileList_DragOver"
                          Drop="FileList_Drop"
                          SelectionChanged="FileList_SelectionChanged"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Item"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView AllowsColumnReorder="True">
                            <GridViewColumn Header="{DynamicResource L_ColName}" Width="420">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,1,6,1">
                                            <!--
                                                Иконка берётся конвертером, а не свойством модели:
                                                так она запрашивается только для отрисовываемых строк
                                                и виртуализация продолжает работать.
                                            -->
                                            <Image Width="16" Height="16" Margin="0,0,7,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                   Source="{Binding Converter={StaticResource Icon}}"/>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource NameCell}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!--
                                У остальных колонок свои шаблоны только ради отступов:
                                DisplayMemberBinding рисует текст вплотную к границам ячейки.
                            -->
                            <GridViewColumn Header="{DynamicResource L_ColSize}" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" Margin="6,1,10,1"
                                                   HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{DynamicResource L_ColModified}" Width="190">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModifiedText}" Margin="8,1,10,1"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{DynamicResource L_ColType}" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TypeText}" Margin="8,1,10,1"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{DynamicResource L_ColAttrib}" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AttributesText}" Margin="8,1,10,1"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                              x:Name="TerminalSplitter"
                              Background="{DynamicResource Background}"/>

                <!--
                    ПРАВАЯ ПОЛОВИНА: встроенная консоль, как в Far Manager, только в одном окне.
                    Поверх неё открывается редактор (F4), закрытие которого возвращает консоль.
                -->
                <Border Grid.Column="4" x:Name="RightPane"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Background="{DynamicResource Selection}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="TerminalTitle" Margin="8,2,0,2"
                                       Foreground="{DynamicResource Accent}"
                                       TextTrimming="CharacterEllipsis" Text="{DynamicResource L_Console}"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="SyncButton" Content="{DynamicResource L_SyncFolder}" Padding="6,0" BorderThickness="0"
                                        ToolTip="{DynamicResource L_SyncTooltip}"
                                        Click="TerminalSync_Click"/>
                                <Button Content="↻" Width="26" Padding="0" BorderThickness="0"
                                        ToolTip="{DynamicResource L_RestartShell}" Click="TerminalRestart_Click"/>
                                <Button Content="⛶" Width="26" Padding="0" BorderThickness="0"
                                        ToolTip="{DynamicResource L_MaximizeTerminal}" Click="TerminalMaximize_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" x:Name="TerminalHost"/>

                        <local:TempleEditor Grid.Row="0" Grid.RowSpan="2" x:Name="Editor"/>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="5" Width="4" HorizontalAlignment="Stretch"
                              Background="{DynamicResource Background}"/>

                <!-- Панель сведений. Скрыта по умолчанию, открывается по F12. -->
                <local:DetailsPanel Grid.Column="6" x:Name="Details" Visibility="Collapsed"/>
            </Grid>

            <!-- СТАТУСНАЯ СТРОКА -->
            <Grid Grid.Row="4" Background="{DynamicResource Selection}" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="StatusText" Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Accent}"
                           Text="{DynamicResource L_Ready}"/>

                <TextBlock Grid.Column="1" x:Name="DiskText" Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Accent}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
