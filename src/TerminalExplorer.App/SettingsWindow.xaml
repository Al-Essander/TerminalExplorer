<Window x:Class="TerminalExplorer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="НАСТРОЙКИ"
        Height="620" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Background}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource Selection}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="  НАСТРОЙКИ" VerticalAlignment="Center"
                           Foreground="{DynamicResource Accent}"/>
                <Button HorizontalAlignment="Right" Width="34" Content="X"
                        BorderThickness="0" Click="Close_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="14,0,14,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="ТЕМА" Style="{StaticResource SectionTitle}"/>
                    <WrapPanel>
                        <Button x:Name="ThemeCalm" Content="Спокойная" Click="Theme_Click" Tag="0"/>
                        <Button x:Name="ThemeDos" Content="DOS синий" Margin="4,0,0,0" Click="Theme_Click" Tag="1"/>
                        <Button x:Name="ThemeDosFar" Content="DOS Far" Margin="4,0,0,0" Click="Theme_Click" Tag="2"/>
                        <Button x:Name="ThemeClassic" Content="Классика" Margin="4,0,0,0" Click="Theme_Click" Tag="3"/>
                        <Button x:Name="ThemeCustom" Content="Своя" Margin="4,0,0,0" Click="Theme_Click" Tag="4"/>
                    </WrapPanel>
                    <TextBlock Text="F9 переключает тему прямо в окне проводника"
                               Foreground="{DynamicResource Dim}" Margin="0,6,0,0"/>

                    <TextBlock Text="ЦВЕТА (своя тема)" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Формат #RRGGBB или #AARRGGBB. Изменения применяются сразу."
                               Foreground="{DynamicResource Dim}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="ColorList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Title}"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="{Binding Key}" TextChanged="Color_TextChanged"/>
                                    <!-- Образец кликабелен: открывает HSV-палитру для этого цвета. -->
                                    <Button Grid.Column="2" Margin="6,0,0,0" Padding="0"
                                            Tag="{Binding}" Click="PickColor_Click"
                                            ToolTip="Выбрать цвет">
                                        <Rectangle Width="22" Height="14" Fill="{Binding Preview}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Скопировать цвета из текущей темы" Margin="0,6,0,0"
                            HorizontalAlignment="Left" Click="SeedColors_Click"/>

                    <TextBlock Text="ШРИФТ" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Размер" Style="{StaticResource FieldLabel}"/>
                        <Slider Grid.Column="1" x:Name="FontSizeSlider" Minimum="6" Maximum="40"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="FontSize_Changed"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Семейство" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="FontFamilyBox" TextChanged="FontFamily_Changed"/>
                    </Grid>

                    <TextBlock Text="ВКЛАДКИ" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Высота" Style="{StaticResource FieldLabel}"/>
                        <Slider Grid.Column="1" x:Name="TabHeightSlider" Minimum="16" Maximum="80"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="TabHeight_Changed"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Макс. ширина" Style="{StaticResource FieldLabel}"/>
                        <Slider Grid.Column="1" x:Name="TabWidthSlider" Minimum="40" Maximum="600"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                ValueChanged="TabWidth_Changed"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Отступы" Style="{StaticResource FieldLabel}"/>
                        <Slider Grid.Column="1" x:Name="TabPaddingSlider" Minimum="0" Maximum="60"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="TabPadding_Changed"/>
                    </Grid>

                    <TextBlock Text="ЗВУК" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="SoundCheck" Content="Звуки интерфейса"
                              Foreground="{DynamicResource Foreground}"
                              Checked="Sound_Changed" Unchecked="Sound_Changed"/>
                    <TextBlock x:Name="SoundHint" Foreground="{DynamicResource Dim}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Открыть папку звуков" Click="OpenSounds_Click"/>
                        <Button Content="Перечитать" Margin="4,0,0,0" Click="ReloadSounds_Click"/>
                    </StackPanel>

                    <TextBlock Text="ПОВЕДЕНИЕ" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="NewTabCheck" Content="Открывать папки в новой вкладке"
                              Foreground="{DynamicResource Foreground}"
                              Checked="Behaviour_Changed" Unchecked="Behaviour_Changed"/>

                    <TextBlock Text=" " Margin="0,0,0,10"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Background="{DynamicResource Selection}" Height="34">
                <TextBlock x:Name="PathHint" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Dim}"/>
                <Button Content="Готово" HorizontalAlignment="Right" Margin="0,4,8,4"
                        Click="Close_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
