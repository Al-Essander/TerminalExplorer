<Window x:Class="TerminalExplorer.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource L_PreviewTitle}"
        Height="560" Width="720"
        MinHeight="300" MinWidth="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Background}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1"
            Background="{DynamicResource Background}"
            Margin="18"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource Selection}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Foreground="{DynamicResource Accent}"
                           TextTrimming="CharacterEllipsis"/>
                <Button HorizontalAlignment="Right" Width="34" Content="X"
                        BorderThickness="0" Click="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="8" Background="{DynamicResource Surface}">
                <ScrollViewer x:Name="PdfViewer" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PdfPages" Margin="0"/>
                </ScrollViewer>
                <TextBox x:Name="PreviewText" Visibility="Collapsed"
                         IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         Background="Transparent" BorderThickness="0"
                         FontFamily="{DynamicResource MonoFont}"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </Grid>

            <Grid Grid.Row="2" Background="{DynamicResource Selection}" Height="30">
                <TextBlock x:Name="StatusText" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Dim}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Button Content="{DynamicResource L_Close}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>