<UserControl x:Class="TerminalExplorer.DetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Background}">

    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource Surface}" Height="24">
                <TextBlock Text=" СВЕДЕНИЯ" VerticalAlignment="Center"
                           Foreground="{DynamicResource Accent}"/>

                <!-- Индикатор обращений файловой системы: мигает на каждое событие. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                    <TextBlock x:Name="ActivityGlyph" Text="о" VerticalAlignment="Center"
                               Foreground="{DynamicResource Dim}"/>
                    <TextBlock x:Name="ActivityText" Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Dim}"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,8,10,10">
                <StackPanel>

                    <!-- ОБЪЕКТ -->
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="ObjectIcon" Width="32" Height="32" VerticalAlignment="Top"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock x:Name="ObjectName" TextWrapping="Wrap" FontWeight="Bold"/>
                            <TextBlock x:Name="ObjectKind" Foreground="{DynamicResource Dim}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="ObjectFacts" Margin="0,10,0,0" TextWrapping="Wrap"/>

                    <!-- BLENDER: превью из самого файла и содержимое сцены -->
                    <StackPanel x:Name="BlenderSection" Visibility="Collapsed">
                        <TextBlock Text="BLENDER" Foreground="{DynamicResource Accent}" Margin="0,16,0,4"/>

                        <Border x:Name="ThumbnailFrame" Visibility="Collapsed"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                HorizontalAlignment="Left" Margin="0,0,0,8">
                            <Image x:Name="ThumbnailImage" MaxWidth="256" MaxHeight="256"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <TextBlock x:Name="BlenderFacts" TextWrapping="Wrap"/>

                        <TextBlock x:Name="BlenderContent" FontFamily="{DynamicResource MonoFont}"
                                   Margin="0,8,0,0"/>

                        <TextBlock x:Name="BlenderNote" Foreground="{DynamicResource Dim}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <Button x:Name="OpenInBlender" Content="Открыть в Blender"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                Click="OpenInBlender_Click"/>
                    </StackPanel>

                    <!-- ДЕРЕВО -->
                    <TextBlock Text="СТРУКТУРА" Foreground="{DynamicResource Accent}" Margin="0,16,0,4"/>
                    <TextBlock x:Name="TreeText" FontFamily="{DynamicResource MonoFont}"
                               Foreground="{DynamicResource Foreground}"/>

                    <!-- КАРТА ЗАНЯТОСТИ -->
                    <TextBlock Text="ЧТО ЗАНИМАЕТ МЕСТО" Foreground="{DynamicResource Accent}" Margin="0,16,0,4"/>
                    <ItemsControl x:Name="TypeMap">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Dim}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Bar}"
                                               Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Value}"
                                               Margin="6,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- РАСПРЕДЕЛЕНИЕ РАЗМЕРОВ -->
                    <TextBlock Text="РАСПРЕДЕЛЕНИЕ РАЗМЕРОВ" Foreground="{DynamicResource Accent}" Margin="0,16,0,4"/>
                    <TextBlock x:Name="HistogramText" FontFamily="{DynamicResource MonoFont}"
                               Foreground="{DynamicResource Foreground}"/>
                    <TextBlock x:Name="HistogramNote" Foreground="{DynamicResource Dim}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <!-- ЗАКОН БЕНФОРДА -->
                    <TextBlock Text="ПЕРВЫЕ ЦИФРЫ РАЗМЕРОВ" Foreground="{DynamicResource Accent}" Margin="0,16,0,4"/>
                    <TextBlock x:Name="BenfordText" FontFamily="{DynamicResource MonoFont}"
                               Foreground="{DynamicResource Foreground}"/>
                    <TextBlock x:Name="BenfordNote" Foreground="{DynamicResource Dim}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <!-- СТОИМОСТЬ -->
                    <TextBlock Text="ЧЕГО ЭТО СТОИЛО" Foreground="{DynamicResource Accent}" Margin="0,16,0,4"/>
                    <TextBlock x:Name="CostText" TextWrapping="Wrap"
                               Foreground="{DynamicResource Foreground}"/>

                    <TextBlock Text=" " Margin="0,0,0,8"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
