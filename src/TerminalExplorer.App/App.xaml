<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TerminalExplorer.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Палитра идёт первой и подменяется целиком при смене темы (F9).
                    Индекс 0 зафиксирован в ThemeManager — порядок здесь значим.
                -->
                <ResourceDictionary Source="Palette.Calm.xaml"/>
                <ResourceDictionary Source="Theme.xaml"/>
                <!-- Словарь строк интерфейса. Слот 2 зафиксирован в LanguageManager. -->
                <ResourceDictionary Source="Strings.Ru.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
