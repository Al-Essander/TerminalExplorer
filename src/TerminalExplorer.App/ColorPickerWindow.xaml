<Window x:Class="TerminalExplorer.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource L_PickColorTitle}"
        Height="430" Width="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Background}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="None" ResizeMode="NoResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource Selection}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="{DynamicResource L_PickColorTitle}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Accent}"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="12">

                <!--
                    Квадрат насыщенность/яркость: два наложенных градиента поверх чистого тона —
                    белый по горизонтали даёт насыщенность, чёрный по вертикали — яркость.
                    Так устроен стандартный HSV-селектор.
                -->
                <Border BorderBrush="{DynamicResource BevelDark}" BorderThickness="1,1,0,0">
                    <Border BorderBrush="{DynamicResource BevelLight}" BorderThickness="0,0,1,1">
                        <Grid x:Name="SvField" Height="170"
                              MouseLeftButtonDown="SvField_MouseDown"
                              MouseMove="SvField_MouseMove"
                              Background="Transparent">
                            <Rectangle x:Name="HueLayer"/>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#FFFFFFFF"/>
                                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#00000000"/>
                                        <GradientStop Offset="1" Color="#FF000000"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Canvas>
                                <Ellipse x:Name="Marker" Width="11" Height="11"
                                         Stroke="White" StrokeThickness="2"
                                         IsHitTestVisible="False"/>
                            </Canvas>
                        </Grid>
                    </Border>
                </Border>

                <TextBlock Text="{DynamicResource L_Hue}" Foreground="{DynamicResource Dim}" Margin="0,10,0,2"/>
                <Border BorderBrush="{DynamicResource BevelDark}" BorderThickness="1,1,0,0">
                    <Border BorderBrush="{DynamicResource BevelLight}" BorderThickness="0,0,1,1">
                        <Grid Height="22" x:Name="HueField"
                              MouseLeftButtonDown="HueField_MouseDown"
                              MouseMove="HueField_MouseMove">
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0.000" Color="#FFFF0000"/>
                                        <GradientStop Offset="0.167" Color="#FFFFFF00"/>
                                        <GradientStop Offset="0.333" Color="#FF00FF00"/>
                                        <GradientStop Offset="0.500" Color="#FF00FFFF"/>
                                        <GradientStop Offset="0.667" Color="#FF0000FF"/>
                                        <GradientStop Offset="0.833" Color="#FFFF00FF"/>
                                        <GradientStop Offset="1.000" Color="#FFFF0000"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Canvas>
                                <Rectangle x:Name="HueMarker" Width="3" Height="22"
                                           Fill="White" IsHitTestVisible="False"/>
                            </Canvas>
                        </Grid>
                    </Border>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{DynamicResource L_Hex}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Dim}"/>
                    <TextBox Grid.Column="1" x:Name="HexBox" KeyDown="Hex_KeyDown"
                             LostFocus="Hex_LostFocus"/>
                    <Border Grid.Column="2" Width="46" Margin="8,0,0,0"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <Rectangle x:Name="Preview"/>
                    </Border>
                </Grid>

                <TextBlock x:Name="ValuesText" Foreground="{DynamicResource Dim}" Margin="0,8,0,0"/>
            </StackPanel>

            <Grid Grid.Row="2" Background="{DynamicResource Selection}" Height="38">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,8,5">
                    <Button Content="{DynamicResource L_Cancel}" Click="Cancel_Click"/>
                    <Button Content="{DynamicResource L_Choose}" Margin="6,0,0,0" Click="Accept_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
