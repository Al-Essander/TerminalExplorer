<Window x:Class="TerminalExplorer.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource L_RenameTitle}"
        Height="180" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Background}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1"
            Background="{DynamicResource Background}"
            Margin="18"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource Selection}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="{DynamicResource L_RenameTitle}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Accent}"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="14,14,14,0">
                <TextBlock x:Name="HintText" Foreground="{DynamicResource Dim}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBox x:Name="NameBox" Margin="0,8,0,0" KeyDown="Name_KeyDown"/>
                <TextBlock x:Name="ErrorText" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="2" Background="{DynamicResource Selection}" Height="40">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,10,6">
                    <Button Content="{DynamicResource L_Cancel}" Click="Cancel_Click"/>
                    <Button Content="{DynamicResource L_Rename}" Margin="6,0,0,0" Click="Accept_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
