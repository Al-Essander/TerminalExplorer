<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TerminalExplorer</AssemblyName>
    <RootNamespace>TerminalExplorer</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Значок окна (панель задач, Alt+Tab); значок самого exe задаёт ApplicationIcon выше. -->
    <Resource Include="app.ico"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      Аддоны лежат в проекте и копируются рядом с exe. Так они видны в репозитории,
      правятся вместе с кодом и ставятся вместе с программой — в отличие от %APPDATA%,
      куда попадают только пользовательские данные.
    -->
    <Content Include="Addons\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Addons\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TerminalExplorer.Core\TerminalExplorer.Core.csproj" />
  </ItemGroup>

</Project>