<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Window title -->
    <sys:String x:Key="L_AppTitle">TERMINAL EXPLORER</sys:String>
    <sys:String x:Key="L_AppVersion">v0.1</sys:String>

    <!-- Tabs -->
    <sys:String x:Key="L_NewTab">New tab</sys:String>
    <sys:String x:Key="L_NewTabTooltip">New tab (Ctrl+T)</sys:String>
    <sys:String x:Key="L_CloseTab">Close (Ctrl+W)</sys:String>

    <!-- Sidebar -->
    <sys:String x:Key="L_Drives">DRIVES</sys:String>
    <sys:String x:Key="L_Favorites">FAVORITES</sys:String>
    <sys:String x:Key="L_Addons">ADD-ONS</sys:String>
    <sys:String x:Key="L_AddToFavorites">Add current folder (Ctrl+D)</sys:String>
    <sys:String x:Key="L_AddonsFolder">Add-ons folder and refresh list</sys:String>

    <!-- Navigation bar -->
    <sys:String x:Key="L_Back">Back (Alt+Left)</sys:String>
    <sys:String x:Key="L_Forward">Forward (Alt+Right)</sys:String>
    <sys:String x:Key="L_Up">Up (Backspace)</sys:String>
    <sys:String x:Key="L_Search">Search (Ctrl+F)</sys:String>

    <!-- Status -->
    <sys:String x:Key="L_Ready">ready</sys:String>
    <sys:String x:Key="L_SettingsTooltip">Settings (F10)</sys:String>

    <!-- Right pane -->
    <sys:String x:Key="L_Console">CONSOLE</sys:String>
    <sys:String x:Key="L_SyncFolder">⇄ folder</sys:String>
    <sys:String x:Key="L_SyncFolderOn">⇄ folder: on</sys:String>
    <sys:String x:Key="L_SyncFolderOff">⇄ folder: off</sys:String>
    <sys:String x:Key="L_SyncTooltip">Console and file panel follow each other's folder</sys:String>
    <sys:String x:Key="L_RestartShell">Restart shell</sys:String>
    <sys:String x:Key="L_MaximizeTerminal">Maximize console (F11)</sys:String>

    <!-- File menu -->
    <sys:String x:Key="L_MenuOpen">Open</sys:String>
    <sys:String x:Key="L_MenuOpenInTab">Open in new tab</sys:String>
    <sys:String x:Key="L_MenuEdit">View / edit</sys:String>
    <sys:String x:Key="L_MenuCopy">Copy</sys:String>
    <sys:String x:Key="L_MenuCut">Cut</sys:String>
    <sys:String x:Key="L_MenuPaste">Paste</sys:String>
    <sys:String x:Key="L_MenuDelete">Delete</sys:String>
    <sys:String x:Key="L_MenuCopyPath">Copy as path</sys:String>
    <sys:String x:Key="L_MenuReveal">Show in Explorer</sys:String>
    <sys:String x:Key="L_MenuRename">Rename</sys:String>
    <sys:String x:Key="L_MenuTerminal">Open terminal here</sys:String>
    <sys:String x:Key="L_MenuFavorite">Add to favorites</sys:String>
    <sys:String x:Key="L_MenuProperties">Properties</sys:String>
    <sys:String x:Key="L_MenuShell">More: Windows menu...</sys:String>

    <!-- Favorites menu -->
    <sys:String x:Key="L_FavUp">Move up</sys:String>
    <sys:String x:Key="L_FavDown">Move down</sys:String>
    <sys:String x:Key="L_FavRemove">Remove from favorites</sys:String>

    <!-- Drive menu -->
    <sys:String x:Key="L_DriveFavorite">Add to favorites</sys:String>

    <!-- Main menu -->
    <sys:String x:Key="L_AddonsSubmenu">Add-ons</sys:String>
    <sys:String x:Key="L_ProgramAddons">Program add-ons folder</sys:String>
    <sys:String x:Key="L_UserAddons">My add-ons folder</sys:String>
    <sys:String x:Key="L_QuickAccess">Quick access</sys:String>
    <sys:String x:Key="L_FavoritesEmpty">favorites empty</sys:String>
    <sys:String x:Key="L_OpenTerminalHere">Open terminal here</sys:String>
    <sys:String x:Key="L_DataFolder">Program data folder</sys:String>
    <sys:String x:Key="L_Settings">Settings</sys:String>
    <sys:String x:Key="L_Exit">Exit</sys:String>

    <!-- List columns -->
    <sys:String x:Key="L_ColName">NAME</sys:String>
    <sys:String x:Key="L_ColSize">SIZE</sys:String>
    <sys:String x:Key="L_ColModified">MODIFIED</sys:String>
    <sys:String x:Key="L_ColType">TYPE</sys:String>
    <sys:String x:Key="L_ColAttrib">ATTR.</sys:String>
</ResourceDictionary>